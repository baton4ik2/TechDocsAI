# Учётные данные администратора (первый вход)
ADMIN_EMAIL=admin@techdocs.local
ADMIN_PASSWORD=admin123

# Секрет для JWT-токенов (замените на длинную случайную строку!)
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret-key

# ИИ-провайдер. По умолчанию — локальный Ollama из docker-compose:
# бесплатно, без ключей, документы не покидают сервер.
# Модель качается автоматически при первом запуске (~4.7 ГБ), нужно ~8 ГБ RAM.
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen2.5:7b

# Слабый сервер? Возьмите модель поменьше (~2 ГБ, качество ниже):
# AI_CHAT_MODEL=qwen2.5:3b

# --- Vision (извлечение оборудования из сканов) -----------------------------
# Vision-модель читает картинку страницы напрямую, без OCR — на кривых сканах
# это радикально точнее. Провайдер vision может отличаться от чатового:
# чат остаётся локальным, а в облако уходят ТОЛЬКО страницы, отправленные
# на извлечение кнопкой в интерфейсе.

# Вариант А: локально (бесплатно, ~6 ГБ, скачается автоматически)
# AI_VISION_MODEL=qwen2.5vl:7b

# Вариант Б: облачный Gemini через OpenRouter (рекомендуется для качества;
# ключ на openrouter.ai, пополнение от $5)
# AI_VISION_BASE_URL=https://openrouter.ai/api/v1
# AI_VISION_API_KEY=sk-or-v1-...
# AI_VISION_MODEL=google/gemini-2.5-flash-lite

# Вариант В: Gemini напрямую через Google AI Studio (ключ на aistudio.google.com)
# AI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_VISION_API_KEY=AIza...
# AI_VISION_MODEL=gemini-2.5-flash-lite

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

# --- Подбор расценок для смет (раздел «Нормативы») --------------------------
# Текстовая модель для ИИ-подбора расценки под описание работы/оборудования.
# Дёшево: модели уходит не весь сборник, а короткий список найденных расценок
# (полнотекстовый поиск отбирает кандидатов бесплатно). Можно указать более
# сильную модель, чем чатовая. Если пусто — используется основной провайдер
# (AI_BASE_URL). Если и он не настроен — показываются кандидаты из поиска без ИИ.

# Gemini 2.5 через routerai.ru (OpenAI-совместимый, текстовая модель):
# AI_MATCH_BASE_URL=https://routerai.ru/api/v1
# AI_MATCH_API_KEY=sk-...
# AI_MATCH_MODEL=gemini-2.5-flash-lite

# Gemini напрямую через Google AI Studio:
# AI_MATCH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MATCH_API_KEY=AIza...
# AI_MATCH_MODEL=gemini-2.5-flash-lite

AI_MATCH_BASE_URL=
AI_MATCH_API_KEY=
AI_MATCH_MODEL=

# --- Проверка готовой сметы («Проверить смету») -----------------------------
# Отдельная, заведомо более сильная модель: здесь не выбор из короткого списка,
# а вычитка всей сметы вместе с эталоном — задача на рассуждение. Запускается
# вручную перед сдачей, поэтому расход разовый: смета на 200 строк укладывается
# примерно в 20 тыс. токенов. Модель возвращает только замечания и НИЧЕГО не
# меняет в смете. Если пусто — используется основной провайдер (AI_BASE_URL);
# если и он не настроен, проверка честно сообщит, что модель не задана.

# AI_REVIEW_BASE_URL=https://routerai.ru/api/v1
# AI_REVIEW_API_KEY=sk-...
# AI_REVIEW_MODEL=google/gemini-2.5-pro

AI_REVIEW_BASE_URL=
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=

# Модели через запятую, между которыми можно переключаться прямо на смете —
# чтобы сравнить их на одних и тех же данных, не пересобирая контейнер.
# AI_REVIEW_MODEL из этого списка используется по умолчанию. Запрос принимается
# только с моделью отсюда: произвольное название из браузера означало бы
# обращение к чему угодно за счёт владельца ключа.
# AI_REVIEW_MODELS=anthropic/claude-opus-5,anthropic/claude-sonnet-5,google/gemini-2.5-pro,google/gemini-2.5-flash

AI_REVIEW_MODELS=

# Модель для ПРОСТОГО разбора замечания («Разобрать подробно»). Нужен он редко:
# короткий разбор модель пишет прямо в ответе проверки, а эта кнопка остаётся
# для замечаний без него — например, в проверках, сделанных раньше. Задача
# несложная, поэтому сильная модель здесь не нужна: на ней такой разбор стоит
# около 2 ₽, на быстрой — копейки.
#
# ВАЖНО: «Разобрать глубже» сюда НЕ относится. Он существует ради глубины —
# видит состав работ расценки, соседние строки и эталон — и всегда идёт той же
# моделью, что и проверка. Иначе получилось бы наоборот: сложный разбор на
# слабой модели, простой — на сильной.
#
# Пусто — простой разбор тоже идёт моделью проверки.
# AI_REVIEW_EXPLAIN_MODEL=google/gemini-2.5-flash

AI_REVIEW_EXPLAIN_MODEL=

# --- Разбор паспортов оборудования ---
# Из паспорта вытаскиваются плановые работы с периодичностью. Текст короткий
# (окно вокруг раздела об обслуживании), от модели требуется не рассуждать, а
# найти факт и привести дословную цитату — поэтому здесь дешёвая модель, и
# отдельный провайдер не нужен: запрос идёт через AI_MATCH_BASE_URL/KEY, меняется
# только название модели. Пусто — берётся AI_MATCH_MODEL.
# AI_PASSPORT_MODEL=google/gemini-2.5-flash-lite

AI_PASSPORT_MODEL=

# Модели через запятую для переключения прямо в карточке оборудования: паспорта
# бывают разной сложности (таблица регламента против сплошного текста), и на
# трудных дешёвая модель пропускает работы. Запрос принимается только с моделью
# из этого списка.
# AI_PASSPORT_MODELS=google/gemini-2.5-flash-lite,google/gemini-2.5-flash,anthropic/claude-sonnet-5

AI_PASSPORT_MODELS=

# Вариант с OpenAI (платно, качество выше):
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_CHAT_MODEL=gpt-4o-mini

# Любой другой OpenAI-совместимый API (OpenRouter, DeepSeek, VseGPT и т.п.):
# укажите их AI_BASE_URL, AI_API_KEY и название модели.

# --- Google Drive (необязательно) --------------------------------------------
# Путь к JSON-ключу сервисного аккаунта Google внутри контейнера. Положите файл
# в папку ./secrets рядом с docker-compose.yml (она монтируется в /secrets).
# Затем расшарьте нужные папки Drive на email сервисного аккаунта.
# DRIVE_SERVICE_ACCOUNT_KEY=/secrets/google-service-account.json
DRIVE_SERVICE_ACCOUNT_KEY=
