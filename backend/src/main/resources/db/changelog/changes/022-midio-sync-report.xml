<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Последний отчёт синхронизации с Midio. Раньше он жил только в состоянии
        страницы: ушёл со страницы — потерял список ручных подтверждений до
        нового прогона. Одна запись: новый прогон заменяет предыдущий,
        подтверждение связи вычёркивает позицию из сохранённого отчёта.
    -->
    <changeSet id="022-01-midio-sync-report" author="techdocs">
        <createTable tableName="midio_sync_reports">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="report" type="TEXT"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
