<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Обязательная работа или рекомендуемая. Различие денежное: рекомендуемые
        заказчик оплачивать не обязан, и смешивать их с обязательными в смете
        нельзя. Midio это различает (MANDATORY / RECOMMENDED) — сохраняем, чтобы
        инженер видел, за что именно выставляется счёт.
    -->
    <changeSet id="021-01-planned-work-mandatory" author="techdocs">
        <addColumn tableName="planned_works">
            <column name="mandatory" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
